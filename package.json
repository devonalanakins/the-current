{
  "name": "the-current",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An independent narrative briefing application; original synthetic demonstration.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.10.0 <25"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "node dist/seed.js",
    "start": "node dist/server.js",
    "dev": "npm run build && npm start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "backup": "node scripts/backup.mjs",
    "recovery": "node scripts/recovery.mjs",
    "release:package": "node scripts/package-release.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
